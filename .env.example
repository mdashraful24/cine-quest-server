# Copy this file to `.env` and fill in each value.
# `.env` is git-ignored; never commit real secrets.

# PostgreSQL connection string.
DATABASE_URL="YOUR_DATABASE_URL"

# Port the API listens on.
PORT="YOUR_PORT"

# Runtime mode: development | production.
NODE_ENV="YOUR_NODE_ENV"

# Base path for all API routes.
API_PREFIX="/api"

# Frontend origin allowed to send credentialed requests.
FRONTEND_URL="YOUR_FRONTEND_URL"

# Number of trusted reverse proxies. Use 0 for local development.
TRUST_PROXY="YOUR_TRUST_PROXY"

# Cloudinary credentials for image and file uploads.
CLOUDINARY_CLOUD_NAME="YOUR_CLOUDINARY_CLOUD_NAME"
CLOUDINARY_API_KEY="YOUR_CLOUDINARY_API_KEY"
CLOUDINARY_API_SECRET="YOUR_CLOUDINARY_API_SECRET"

# Create demo data on boot: true | false.
SEED_ON_START="false"
