model Movie {
  id String @id @default(uuid())

  title          String  @unique
  releaseYear    Int
  runtimeMinutes Int
  watched        Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  prerequisiteLinks MoviePrerequisite[] @relation("MoviePrerequisites")
  dependentLinks    MoviePrerequisite[] @relation("PrerequisiteFor")

  @@index([releaseYear])
  @@index([watched])
  @@map("movies")
}

model MoviePrerequisite {
  movieId        String
  prerequisiteId String

  movie        Movie @relation("MoviePrerequisites", fields: [movieId], references: [id], onDelete: Cascade)
  prerequisite Movie @relation("PrerequisiteFor", fields: [prerequisiteId], references: [id], onDelete: Restrict)

  @@id([movieId, prerequisiteId])
  @@index([prerequisiteId])
  @@map("movie_prerequisites")
}
