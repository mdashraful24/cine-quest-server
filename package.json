{
	"name": "cine-quest-server",
	"version": "1.0.0",
	"description": "Backend API for CineQuest",
	"main": "dist/server.js",
	"scripts": {
		"dev": "bun --watch src/server.ts",
		"build": "tsup",
		"start": "node dist/server.js",
		"typecheck": "tsc --noEmit",
		"db:generate": "bun --bun run prisma generate",
		"db:migrate": "bun --bun run prisma migrate dev",
		"db:deploy": "bun --bun run prisma migrate deploy",
		"db:studio": "bun --bun run prisma studio",
		"db:seed": "bun prisma/seed/run.ts",
		"format:check": "bunx @biomejs/biome format ./src ./prisma/seed",
		"format:fix": "bunx @biomejs/biome format --write ./src ./prisma/seed",
		"lint:check": "bunx @biomejs/biome lint ./src ./prisma/seed",
		"lint:fix": "bunx @biomejs/biome lint --write ./src ./prisma/seed"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"type": "module",
	"dependencies": {
		"@prisma/adapter-pg": "^7.10.1",
		"@prisma/client": "7",
		"cloudinary": "^2.11.0",
		"compression": "^1.8.2",
		"cors": "^2.8.6",
		"dotenv": "^18.0.8",
		"express": "^5.3.0",
		"express-rate-limit": "^8.7.1",
		"helmet": "^8.3.0",
		"http-status": "^2.1.0",
		"multer": "^2.5.0",
		"pg": "^8.23.1",
		"winston": "^3.19.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@types/compression": "^1.8.1",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/multer": "^2.3.0",
		"@types/node": "^26.6.5",
		"@types/pg": "^8.23.1",
		"prisma": "^7.10.1",
		"tsup": "^9.0.0",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2"
	}
}
