        {
          "name": "Get Rewatch Order",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  ""
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}{{apiPrefix}}/movies/{{targetMovieId}}/rewatch-order",
              "host": [
                "{{baseUrl}}{{apiPrefix}}"
              ],
              "path": [
                "movies",
                "{{targetMovieId}}",
                "rewatch-order"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Update Movie (form-data)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Movie updated with 200', () => {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Watched state updated', () => {",
                  "    pm.expect(pm.response.json().data.watched).to.eql(true);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "watched",
                  "value": "true",
                  "type": "text"
                },
                {
                  "key": "image",
                  "type": "file",
                  "description": "Optional image. Enable this row and choose jpeg, png, webp, or gif.",
                  "value": null,
                  "disabled": true
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}{{apiPrefix}}/movies/{{movieId}}",
              "host": [
                "{{baseUrl}}{{apiPrefix}}"
              ],
              "path": [
                "movies",
                "{{movieId}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Circular Dependency Test (raw JSON)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Cycle rejected with 409', () => {",
                  "    pm.response.to.have.status(409);",
                  "});",
                  "",
                  "pm.test('Error code is CIRCULAR_DEPENDENCY', () => {",
                  "    pm.expect(pm.response.json().code).to.eql('CIRCULAR_DEPENDENCY');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"prerequisiteIds\": [\"{{prerequisiteMovieId}}\"]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}{{apiPrefix}}/movies/{{movieId}}",
              "host": [
                "{{baseUrl}}{{apiPrefix}}"
              ],
              "path": [
                "movies",
                "{{movieId}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Delete Movie",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Movie deleted with 200', () => {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Deleted id returned', () => {",
                  "    pm.expect(pm.response.json().data.id).to.eql(pm.collectionVariables.get('movieId'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}{{apiPrefix}}/movies/{{movieId}}",
              "host": [
                "{{baseUrl}}{{apiPrefix}}"
              ],
              "path": [
                "movies",
                "{{movieId}}"
              ]
            }
          },
          "response": []
        }
